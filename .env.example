# Copy to .env locally if your runner/tool loads dotenv files.
# Never commit a real API key.

# Any OpenAI-compatible Chat Completions service. The URL may be a base URL
# (for example https://open.bigmodel.cn/api/paas/v4) or the full endpoint.
MODEL_API_KEY=
MODEL_API_MODEL=glm-5.1
MODEL_API_BASE_URL=https://open.bigmodel.cn/api/paas/v4
MODEL_API_AUTH_HEADER=Authorization
# Use "none" when the header contains the raw key (for example api-key: <key>).
MODEL_API_AUTH_SCHEME=Bearer
MODEL_API_JSON_MODE=false
MODEL_API_TOKEN_FIELD=max_tokens
MODEL_API_TIMEOUT_SECONDS=30

# Legacy MiMo configuration remains available when MODEL_API_* is unset.
MIMO_API_KEY=
MIMO_RULE_MODEL=mimo-v2.5-pro
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1

# Zhipu remains available for later comparison/recovery.
ZHIPU_API_KEY=
ZHIPU_RULE_MODEL=glm-5.1
